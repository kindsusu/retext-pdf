          <!-- v6.1 (package.json build.appx.customExtensionsPath): Markdown·텍스트·그림을 "연결 프로그램" 목록에 올린다.
               Store(MSIX) 앱의 파일 형식 연결은 목록에만 더해지고 기본 앱을 가져가지 않는다(기본 앱은 사용자가 고른다).
               .pdf는 build.fileAssociations가 따로 만든다 -->
          <uap:Extension Category="windows.fileTypeAssociation">
            <uap:FileTypeAssociation Name="retextpdf.text">
              <uap:DisplayName>텍스트 문서</uap:DisplayName>
              <uap:SupportedFileTypes>
                <uap:FileType>.md</uap:FileType>
                <uap:FileType>.markdown</uap:FileType>
                <uap:FileType>.txt</uap:FileType>
              </uap:SupportedFileTypes>
            </uap:FileTypeAssociation>
          </uap:Extension>
          <uap:Extension Category="windows.fileTypeAssociation">
            <uap:FileTypeAssociation Name="retextpdf.image">
              <uap:DisplayName>그림 (PDF로 열기)</uap:DisplayName>
              <uap:SupportedFileTypes>
                <uap:FileType>.png</uap:FileType>
                <uap:FileType>.jpg</uap:FileType>
                <uap:FileType>.jpeg</uap:FileType>
                <uap:FileType>.webp</uap:FileType>
                <uap:FileType>.gif</uap:FileType>
                <uap:FileType>.bmp</uap:FileType>
              </uap:SupportedFileTypes>
            </uap:FileTypeAssociation>
          </uap:Extension>
