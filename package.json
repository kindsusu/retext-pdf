{
  "name": "retext-pdf",
  "productName": "Retext PDF",
  "version": "6.0.0",
  "description": "Local PDF and Markdown editor with true text editing and redaction",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node app/server.js",
    "test": "node app/pdf-engine.test.js && node app/text-grouping.test.js && node app/grouping-corpus.test.js && node app/ui-wiring.test.js && node app/server.test.js && node app/pdf-fonts.test.js && node app/pdf-system-fonts.test.js && node app/pdf-edit-service.test.js && node app/pdf-features.test.js && node app/pdf-wave-d.test.js && node app/pdf-wave-e.test.js && node app/pdf-ocr.test.js && node app/pdf-wave-f.test.js && node app/pdf-form-redact.test.js",
    "dist": "electron-builder --win",
    "md2pdf": "electron tools/md2pdf.js",
    "assets": "node tools/demo-assets.js",
    "icon": "electron tools/make-icon.js",
    "dist:store": "node tools/dist-store.js",
    "appx-assets": "electron tools/make-appx-assets.js",
    "hero": "electron tools/make-hero.js",
    "store-art": "electron tools/make-store-art.js",
    "test:ocr": "node tools/ocr-corpus.js"
  },
  "build": {
    "appId": "com.kindsusu.retextpdf",
    "productName": "Retext PDF",
    "artifactName": "Retext-PDF-${version}-${arch}-${os}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**",
      "!app/test-data/**",
      "package.json",
      "workspace/독서모임_안내.md",
      "workspace/독서모임_안내.pdf",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "!node_modules/tesseract.js/{dist,docs,examples,scripts,tests}/**",
      "!node_modules/tesseract.js/karma.conf.js",
      "!node_modules/tesseract.js-core/*.wasm.js",
      "!node_modules/tesseract.js-core/*-lstm.{js,wasm}",
      "!node_modules/zlibjs/**",
      "!node_modules/idb-keyval/**",
      "!node_modules/hunspell-wasm/{src,docs}/**",
      "!node_modules/hunspell-wasm/**/*.map",
      "!node_modules/hunspell-wasm/tsconfig.json"
    ],
    "asar": true,
    "asarUnpack": [
      "app/ocr-worker.js",
      "app/vendor/ocr/**",
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/regenerator-runtime/**",
      "node_modules/is-url/**",
      "node_modules/bmp-js/**",
      "node_modules/wasm-feature-detect/**",
      "app/spell-worker.js",
      "app/spell-core.js",
      "node_modules/hunspell-wasm/**",
      "node_modules/hunspell-dict-ko/**",
      "node_modules/dictionary-en/**"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF 문서",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Retext-PDF-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "Retext-PDF-${version}-setup.exe",
      "shortcutName": "Retext PDF"
    },
    "appx": {
      "applicationId": "RetextPDF",
      "identityName": "susukim.EDITORKIM",
      "publisher": "CN=9E51FDEE-767C-4BB7-A86D-154F244519D6",
      "displayName": "Retext PDF",
      "publisherDisplayName": "susukim",
      "backgroundColor": "#1b1b1f",
      "languages": [
        "ko-KR",
        "en-US"
      ],
      "artifactName": "Retext-PDF-${version}-store.${ext}",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kindsusu/retext-pdf.git"
  },
  "homepage": "https://github.com/kindsusu/retext-pdf",
  "bugs": "https://github.com/kindsusu/retext-pdf/issues",
  "author": "kindsusu",
  "keywords": [
    "pdf",
    "pdf-editor",
    "redaction",
    "pdfium",
    "electron",
    "markdown"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@embedpdf/pdfium": "^2.15.0",
    "dictionary-en": "4.0.0",
    "dompurify": "^3.4.13",
    "fontkit": "^2.0.4",
    "hunspell-dict-ko": "0.1.0",
    "hunspell-wasm": "0.3.0",
    "jpeg-js": "^0.4.4",
    "marked": "^15.0.7",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  }
}
